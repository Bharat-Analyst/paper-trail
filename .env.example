# ===========================================================================
# PaperPilot environment variables — EXAMPLE FILE
# ===========================================================================
# HOW TO USE:
#   1. Copy this file to a new file named ".env"      (cp .env.example .env)
#   2. Fill in the real values below.
#   3. NEVER commit your real ".env" to GitHub — it's already in .gitignore.
#
# On Render (production) you don't upload this file — you paste each of these
# as an "Environment Variable" in the Render dashboard instead. The README
# walks you through that.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1) WHICH LLM PROVIDER TO USE
# ---------------------------------------------------------------------------
# One of: groq | gemini | ollama
# You can swap providers by changing ONLY this line (plus its API key below).
LLM_PROVIDER=groq


# ---------------------------------------------------------------------------
# 2) PROVIDER API KEYS + MODELS
#    You only need to fill in the one that matches LLM_PROVIDER above.
# ---------------------------------------------------------------------------

# --- Groq (default) -------  Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Model to use on Groq. Good default below. See https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini --------  Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Ollama (local, no key needed) ----  Install: https://ollama.com
# Only works where Ollama is running (your laptop), NOT on Render free tier.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1


# ---------------------------------------------------------------------------
# 3) DATABASE
# ---------------------------------------------------------------------------
# Local development: leave as SQLite (a file on disk). Simple, zero setup.
DATABASE_URL=sqlite:///./paperpilot.db
#
# Production (Render): paste your Neon Postgres URL instead. It looks like:
#   postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# The app auto-converts it to the right driver format for you.


# ---------------------------------------------------------------------------
# 4) WEB PUSH NOTIFICATIONS (Phase 2 — optional to start)
# ---------------------------------------------------------------------------
# Generate these ONCE by running:  python scripts/gen_vapid.py
# Then paste the printed values here. Leave blank to disable push entirely
# (the app still works fine without it).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI required by the web-push spec. Use your email.
VAPID_SUBJECT=mailto:you@example.com


# ---------------------------------------------------------------------------
# 5) OPTIONAL: Google Sheets export (OFF by default)
# ---------------------------------------------------------------------------
# Leave false. The README explains how to turn this on later if you ever want
# to mirror your reading log into a Google Sheet. No Google account needed now.
GOOGLE_SHEETS_ENABLED=false
# Path to a Google service-account JSON file (only if you enable the above).
GOOGLE_SHEETS_CREDENTIALS_FILE=
# The spreadsheet ID to write into (the long string in the sheet's URL).
GOOGLE_SHEETS_ID=
